# =============================================================================
# SmartHotel-PMS — environment variables (implementation plan, Appendix A)
#
# Copy to `.env` (git-ignored) and adjust:   PowerShell: Copy-Item .env.example .env
# All values below are DEV-ONLY defaults — never reuse them outside local dev.
# Secrets (API keys, JWT secret) must never be committed; CI uses GitHub
# Actions secrets instead (Phase 12).
# =============================================================================

# --- Docker Compose / PostgreSQL (Phase 0) -----------------------------------
# Superuser — used only by the container itself and the first-run init script.
POSTGRES_DB=smarthotel
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres-dev-password
# Host port mapping (change if 5432 is taken on your machine).
POSTGRES_HOST_PORT=5432
# Least-privilege service users, created by infra/postgres/init/01-init.sh.
PMS_DB_PASSWORD=pms-dev-password
PRICING_DB_PASSWORD=pricing-dev-password

# --- pms-core (consumed from Phase 2) ----------------------------------------
PMS_DB_URL=jdbc:postgresql://localhost:5432/smarthotel?currentSchema=pms
PMS_DB_USER=pms_user
# Password: PMS_DB_PASSWORD (above).
# Generate a real secret with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me-generate-a-256-bit-secret
PRICING_BASE_URL=http://localhost:8000
# Shared internal key — must equal INTERNAL_API_KEY below (plan §3.3).
PRICING_API_KEY=dev-internal-api-key
# Feature flag: false → PMS uses base prices only (fallback/demo mode, D6).
PRICING_ENABLED=true
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Business timezone for app containers (the DB server itself stays on UTC, D16).
TZ=Europe/Warsaw

# --- pricing-service (consumed from Phases 4–7) -------------------------------
# Keep user/password in sync with PRICING_DB_PASSWORD above.
PRICING_DATABASE_URL=postgresql+psycopg://pricing_user:pricing-dev-password@localhost:5432/smarthotel
INTERNAL_API_KEY=dev-internal-api-key
# Google AI Studio key: https://aistudio.google.com/ — leave empty to force the
# heuristic fallback scorer (pipeline still works, D9).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
PROMPT_VERSION=event-impact-v1
GEMINI_DAILY_CALL_BUDGET=200
# Ticketmaster Discovery API key: https://developer.ticketmaster.com/
TICKETMASTER_API_KEY=
# Event source: `static` (fixtures — default for dev/CI/demo) or `ticketmaster`.
EVENT_PROVIDER=static
# Hotel location (Kraków, D16) and event search geometry (plan Phase 7).
HOTEL_LAT=50.0614
HOTEL_LON=19.9366
EVENT_RADIUS_KM=15
EVENT_HORIZON_DAYS=120
# Model registry artifact storage (git-ignored).
MODEL_ARTIFACT_DIR=./artifacts/models

# --- frontend (consumed from Phase 3) ----------------------------------------
VITE_API_BASE_URL=http://localhost:8080

# --- observability profile (consumed from Phase 10) --------------------------
# Memory cap for the single-node Elasticsearch (D14).
ES_JAVA_OPTS=-Xms1g -Xmx1g
