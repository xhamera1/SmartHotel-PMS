# Normalize all text files to LF in the repository and in working trees
# (required for consistent behavior across Windows/WSL2/Linux CI — see Phase 0).
* text=auto eol=lf

# Windows batch scripts require CRLF to run reliably.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files — never normalize.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.parquet binary
*.joblib binary
*.jar binary
