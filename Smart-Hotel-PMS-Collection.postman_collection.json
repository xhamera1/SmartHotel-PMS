  "item": [
    {
      "name": "00 — Quick smoke",
      "description": "Uruchamiaj po kolei (Run folder). Weryfikuje pricing + publiczny booking + login.",
      "item": [
        {
          "name": "1. Pricing health ready",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{pricingBaseUrl}}/health/ready",
            "description": "Oczekuj status UP (model + DB)."
          }
        },
        {
          "name": "2. Pricing model info",
          "request": {
            "auth": {
              "type": "apikey",
              "apikey": [
                { "key": "key", "value": "X-Internal-Api-Key", "type": "string" },
                { "key": "value", "value": "{{internalApiKey}}", "type": "string" },
                { "key": "in", "value": "header", "type": "string" }
              ]
            },
            "method": "GET",
            "header": [],
            "url": "{{pricingBaseUrl}}/api/v1/model"
          }
        },
        {
          "name": "3. Pricing quotes (ML)",
          "request": {
            "auth": {
              "type": "apikey",
              "apikey": [
                { "key": "key", "value": "X-Internal-Api-Key", "type": "string" },
                { "key": "value", "value": "{{internalApiKey}}", "type": "string" },
                { "key": "in", "value": "header", "type": "string" }
              ]
            },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"requestId\": \"{{requestId}}\",\n  \"currency\": \"PLN\",\n  \"items\": [\n    {\n      \"roomTypeCode\": \"{{roomTypeCode}}\",\n      \"date\": \"{{checkIn}}\",\n      \"basePrice\": 350.00,\n      \"minPrice\": 250.00,\n      \"maxPrice\": 700.00,\n      \"occupancyRate\": 0.75,\n      \"roomsRemaining\": 5,\n      \"leadTimeDays\": 30\n    },\n    {\n      \"roomTypeCode\": \"DLX\",\n      \"date\": \"{{checkIn}}\",\n      \"basePrice\": 420.00,\n      \"minPrice\": 300.00,\n      \"maxPrice\": 800.00,\n      \"occupancyRate\": 0.85,\n      \"roomsRemaining\": 2,\n      \"leadTimeDays\": 14\n    }\n  ]\n}"
            },
            "url": "{{pricingBaseUrl}}/api/v1/quotes"
          }
        },
        {
          "name": "4. Events sync (background)",
          "request": {
            "auth": {
              "type": "apikey",
              "apikey": [
                { "key": "key", "value": "X-Internal-Api-Key", "type": "string" },
                { "key": "value", "value": "{{internalApiKey}}", "type": "string" },
                { "key": "in", "value": "header", "type": "string" }
              ]
            },
            "method": "POST",
            "header": [],
            "url": "{{pricingBaseUrl}}/internal/events/sync",
            "description": "202 Accepted. Poczekaj ~2–5 s przed kolejnym requestem."
          }
        },
        {
          "name": "5. List scored events",
          "request": {
            "auth": {
              "type": "apikey",
              "apikey": [
                { "key": "key", "value": "X-Internal-Api-Key", "type": "string" },
                { "key": "value", "value": "{{internalApiKey}}", "type": "string" },
                { "key": "in", "value": "header", "type": "string" }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{pricingBaseUrl}}/api/v1/events?from={{fromDate}}&to={{toDate}}",
              "host": ["{{pricingBaseUrl}}"],
              "path": ["api", "v1", "events"],
              "query": [
                { "key": "from", "value": "{{fromDate}}" },
                { "key": "to", "value": "{{toDate}}" }
              ]
            }
          }
        },
        {
          "name": "6. PMS login (admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  if (body.accessToken) {",
                  "    pm.collectionVariables.set('accessToken', body.accessToken);",
                  "    console.log('accessToken saved');",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": "{{pmsBaseUrl}}/api/v1/auth/login"
          }
        },
        {
          "name": "7. Public availability",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{pmsBaseUrl}}/api/v1/availability?checkIn={{checkIn}}&checkOut={{checkOut}}&guests={{guests}}",
              "host": ["{{pmsBaseUrl}}"],
              "path": ["api", "v1", "availability"],
              "query": [
                { "key": "checkIn", "value": "{{checkIn}}" },
                { "key": "checkOut", "value": "{{checkOut}}" },
                { "key": "guests", "value": "{{guests}}" }
              ]
            }
          }
        }
      ]
    },
