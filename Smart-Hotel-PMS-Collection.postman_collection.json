        {
          "name": "Public — Booking",
          "item": [
            {
              "name": "GET availability",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{pmsBaseUrl}}/api/v1/availability?checkIn={{checkIn}}&checkOut={{checkOut}}&guests={{guests}}",
                  "host": ["{{pmsBaseUrl}}"],
                  "path": ["api", "v1", "availability"],
