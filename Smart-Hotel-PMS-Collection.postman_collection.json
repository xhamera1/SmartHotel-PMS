                    { "key": "guests", "value": "{{guests}}" }
                  ]
                }
              }
            },
            {
              "name": "POST create reservation",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "if (pm.response.code === 201 || pm.response.code === 200) {",
                      "  const body = pm.response.json();",
                      "  if (body.confirmationCode) {",
                      "    pm.collectionVariables.set('confirmationCode', body.confirmationCode);",
                      "  }",
                      "  if (body.id) {",
                      "    pm.collectionVariables.set('reservationId', String(body.id));",
                      "  }",
                      "}"
                    ]
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"roomTypeCode\": \"{{roomTypeCode}}\",\n  \"ratePlanCode\": \"{{ratePlanCode}}\",\n  \"checkIn\": \"{{checkIn}}\",\n  \"checkOut\": \"{{checkOut}}\",\n  \"adults\": {{guests}},\n  \"guest\": {\n    \"firstName\": \"Jan\",\n    \"lastName\": \"Kowalski\",\n    \"email\": \"{{guestEmail}}\",\n    \"phone\": \"+48 600 100 200\"\n  }\n}"
                },
                "url": "{{pmsBaseUrl}}/api/v1/reservations",
                "description": "Zapisuje confirmationCode. Użyj unikalnego guestEmail przy powtórnych testach."
              }
            },
            {
              "name": "GET reservation lookup",
              "request": {
                "method": "GET",
                "header": [],
