    { "key": "pmsBaseUrl", "value": "http://localhost:8080" },
    { "key": "pricingBaseUrl", "value": "http://localhost:8081" },
    { "key": "internalApiKey", "value": "dev-internal-api-key" },
    { "key": "accessToken", "value": "" },
    { "key": "adminEmail", "value": "admin@smarthotel.local" },
    { "key": "adminPassword", "value": "admin-dev-password" },
