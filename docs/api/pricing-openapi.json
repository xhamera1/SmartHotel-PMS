      "QuoteItemRequest": {
        "additionalProperties": false,
        "properties": {
          "basePrice": {
            "anyOf": [
              {
                "exclusiveMinimum": 0.0,
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              }
            ],
            "title": "Baseprice"
          },
          "date": {
            "format": "date",
            "title": "Date",
            "type": "string"
          },
          "leadTimeDays": {
            "minimum": 0.0,
            "title": "Leadtimedays",
            "type": "integer"
          },
          "maxPrice": {
            "anyOf": [
              {
                "exclusiveMinimum": 0.0,
                "type": "number"
              },
