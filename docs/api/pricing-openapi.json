          "roomTypeCode",
          "date",
          "basePrice",
          "minPrice",
          "maxPrice",
          "occupancyRate",
          "roomsRemaining",
          "leadTimeDays"
        ],
        "title": "QuoteItemRequest",
        "type": "object"
      },
