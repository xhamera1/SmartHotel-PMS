                "type": "string"
              }
            ],
            "title": "Minprice"
          },
          "occupancyRate": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Occupancyrate",
            "type": "number"
          },
          "roomTypeCode": {
            "maxLength": 30,
            "minLength": 1,
            "title": "Roomtypecode",
            "type": "string"
          },
          "roomsRemaining": {
            "minimum": 0.0,
            "title": "Roomsremaining",
            "type": "integer"
          }
        },
